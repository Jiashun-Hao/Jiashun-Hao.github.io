---
import { Image } from 'astro:assets'
import PageLayout from '@/layouts/BaseLayout.astro'
import avatar from '@/assets/avatar.png'
import { education, publications, skillGroups } from '@/data/portfolio'
---

<PageLayout meta={{ title: 'About', description: 'Get to know Jiashun Hao: background, education, research and the tools behind the work.' }}>
  <main class='inner-page about-page' id='top'>
    <div class='about-hero-grid'>
      <div class='inner-hero reveal'>
        <span class='section-index'><span class='section-index-line'></span> A LITTLE ABOUT ME</span>
        <h1>Hey, I'm<br /><em>Jiashun Hao.</em></h1>
        <p>你好，我叫 Jiashun Hao。</p>
        <p>I'm a software engineer with a master's degree in Computer Science & Engineering. I love learning how things work — and then turning that understanding into software people can use.</p>
        <p>My interests span backend systems, automation, artificial intelligence, and the small details that make a product feel right.</p>
        <p><strong>Stay hungry, stay foolish.</strong> Always a work in progress.</p>
        <div class='hero-buttons'><a class='btn-primary' href='/projects'>See my projects ↗</a><a class='btn-secondary' href='https://github.com/Jiashun-Hao' target='_blank' rel='noopener noreferrer'>GitHub ↗</a></div>
      </div>
      <div class='about-portrait reveal'><Image src={avatar} width={420} height={420} alt='Portrait of Jiashun Hao' loading='eager' /></div>
    </div>

    <section class='about-panel reveal' aria-labelledby='education-heading'>
      <span class='section-index'><span class='section-index-line'></span> 01 / WHERE I'VE LEARNED</span>
      <h2 id='education-heading'>Education</h2>
      <div class='about-grid'>{education.map((item) => <a class='about-list-item' href={item.url} target='_blank' rel='noopener noreferrer'><span>{item.period}</span><strong>{item.school} ↗</strong><p>{item.degree}</p></a>)}</div>
    </section>
    <section class='about-panel reveal' aria-labelledby='publications-heading'>
      <span class='section-index'><span class='section-index-line'></span> 02 / RESEARCH</span>
      <h2 id='publications-heading'>Publications</h2>
      {publications.map((item) => <a class='about-list-item' href={item.href} target='_blank' rel='noopener noreferrer'><span>{item.venue} · {item.year}</span><strong>{item.title} ↗</strong></a>)}
    </section>
    <section class='about-panel reveal' aria-labelledby='toolbox-heading'>
      <span class='section-index'><span class='section-index-line'></span> 03 / WHAT I WORK WITH</span>
      <h2 id='toolbox-heading'>My toolbox</h2>
      <p class='text-muted-foreground'>A selection of technologies I've used or explored, rather than a claim of expertise in every tool.</p>
      <div class='skills-panel about-tool-list'>{skillGroups.map((group,index) => <div class='skill-row'><span class='skill-row-index'>0{index + 1}</span><h3>{group.title}</h3><div class='skill-chips'>{group.items.map((item) => <span class='skill-chip'>{item}</span>)}</div></div>)}</div>
    </section>
    <section class='contact-section reveal' aria-labelledby='about-contact-title'><div class='contact-glow' aria-hidden='true'></div><span class='section-index'>KEEP IN TOUCH</span><h2 id='about-contact-title'>Good ideas start with a <em>conversation.</em></h2><p>If you'd like to connect, collaborate, or simply say hello, GitHub is a good place to find me.</p><a class='btn-primary' href='https://github.com/Jiashun-Hao' target='_blank' rel='noopener noreferrer'>Connect on GitHub ↗</a></section>
  </main>
</PageLayout>
