---
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectShowcase from '@/components/home/ProjectShowcase.astro'
import { projects, publications } from '@/data/portfolio'
---

<PageLayout meta={{ title: 'Projects', description: 'Selected public projects from Jiashun Hao: language tools, device automation, and graph research.' }}>
  <main class='inner-page' id='top'>
    <div class='inner-hero reveal'>
      <span class='section-index'><span class='section-index-line'></span> PORTFOLIO / SELECTED WORK</span>
      <h1>Built with <em>curiosity.</em></h1>
      <p>A collection of public projects at the intersection of practical software, automation, and research. Each one represents a problem I wanted to understand a little better.</p>
      <a class='btn-secondary' href='https://github.com/Jiashun-Hao' target='_blank' rel='noopener noreferrer'>Explore my GitHub <span aria-hidden='true'>↗</span></a>
    </div>
    <section class='reveal' aria-label='Project gallery'>
      <div class='project-grid inner-project-grid'>{projects.map((project, index) => <ProjectShowcase {project} {index} />)}</div>
    </section>
    <div class='inner-note reveal'><div><strong>Research, writing, and beyond</strong><p>For my academic work, see my conference publications. For more experiments, browse the repositories on GitHub.</p></div><a class='text-link' href={publications[0].href} target='_blank' rel='noopener noreferrer'>View publication ↗</a></div>
  </main>
</PageLayout>
