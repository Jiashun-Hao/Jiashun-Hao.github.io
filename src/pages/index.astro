---
import { Image } from 'astro:assets'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectShowcase from '@/components/home/ProjectShowcase.astro'
import ContactMethods from '@/components/shell/ContactMethods.astro'
import { contact } from '@/data/contact'
import { education, projects, publications, skillGroups } from '@/data/portfolio'
import jiashunPhoto from '@/assets/jiashun.png'

const latestPosts = sortMDByDate(await getBlogCollection()).slice(0, 4)
const dateLabel = (date: Date | undefined) =>
  date ? new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(date) : 'Undated'
---

<PageLayout meta={{ title: 'Home', description: 'Jiashun Hao — Software engineer. Exploring software, intelligent systems, and the ideas in between.' }}>
  <main class='home-page' id='top'>
    <section class='hero-section' aria-labelledby='hero-title'>
      <div class='hero-ambient hero-ambient-one' aria-hidden='true'></div>
      <div class='hero-ambient hero-ambient-two' aria-hidden='true'></div>
      <div class='hero-grid' aria-hidden='true'></div>

      <div class='hero-copy'>
        <div class='hero-eyebrow intro-stagger'><span class='availability-dot'></span> SOFTWARE ENGINEER <span class='eyebrow-sep'>/</span> BASED IN SEOUL</div>
        <h1 id='hero-title' class='hero-title intro-stagger'>Hello, I'm<br /><span class='hero-name'>Jiashun<span class='hero-period'>.</span></span></h1>
        <p class='hero-lead intro-stagger'>I build software and explore<br /><span class='text-gradient'>what technology can become.</span></p>
        <p class='hero-description intro-stagger'>A software engineer with a background in computer science and research. I enjoy turning complex ideas into useful, thoughtful experiences.</p>
        <div class='hero-buttons intro-stagger'>
          <a class='btn-primary' href='#selected-work'>Explore my work <span aria-hidden='true'>↗</span></a>
          <a class='btn-secondary' href='/about'>More about me <span aria-hidden='true'>→</span></a>
        </div>
        <div class='hero-social intro-stagger'>
          <span class='tiny-line'></span>
          <a href='https://github.com/Jiashun-Hao' target='_blank' rel='noopener noreferrer'>GITHUB ↗</a>
          <a href='/blog'>WRITING ↗</a>
          <a href='/rss.xml'>RSS ↗</a>
        </div>
      </div>

      <div class='hero-art intro-stagger' aria-label='Portrait of Jiashun'>
        <div class='hero-art-halo' aria-hidden='true'></div>
        <div class='hero-orbit orbit-one' aria-hidden='true'></div>
        <div class='hero-orbit orbit-two' aria-hidden='true'></div>
        <figure class='hero-photo-frame'>
          <Image
            src={jiashunPhoto}
            alt='Jiashun smiling on a beach at sunset'
            class='hero-photo-image'
            width={1120}
            height={747}
            format='webp'
            quality={86}
            loading='eager'
            decoding='async'
          />
        </figure>
        <div class='float-tag float-tag-top' aria-hidden='true'><span class='tag-symbol'>✦</span> Keep exploring</div>
        <div class='float-tag float-tag-bottom' aria-hidden='true'><span class='tag-symbol color-blue'>●</span> Building something new</div>
        <span class='ambient-spark spark-a' aria-hidden='true'>✳</span>
        <span class='ambient-spark spark-b' aria-hidden='true'>+</span>
        <span class='ambient-spark spark-c' aria-hidden='true'>✧</span>
      </div>
      <a class='scroll-cue' href='#selected-work' aria-label='Scroll to selected work'><span class='scroll-cue-line'></span> SCROLL TO EXPLORE</a>
    </section>

    <section id='selected-work' class='home-section work-section reveal' aria-labelledby='work-title'>
      <div class='section-heading'>
        <div><span class='section-index'><span class='section-index-line'></span> 01 / SELECTED WORK</span><h2 id='work-title'>Things I've <em>built.</em></h2><p>A few experiments and projects from my journey as a developer.</p></div>
        <a class='text-link' href='/projects'>All projects <span aria-hidden='true'>↗</span></a>
      </div>
      <div class='project-grid'>{projects.map((project, index) => <ProjectShowcase {project} {index} />)}</div>
    </section>

    <section class='home-section story-section reveal' id='about-preview' aria-labelledby='story-title'>
      <div class='story-left'><span class='section-index'><span class='section-index-line'></span> 02 / MY STORY</span><h2 id='story-title'>Curiosity<br />is my <em>compass.</em></h2><p>I started in computer science, spent time exploring deep learning research, and continue to find joy in building real-world software.</p><a class='text-link story-link' href='/about'>Get to know me <span aria-hidden='true'>↗</span></a></div>
      <div class='story-right'>
        <div class='story-card'><div class='story-card-top'><span class='story-icon'>⌘</span><span>BACKGROUND</span></div><h3>Engineering meets curiosity.</h3><p>From research problems to practical systems — always connecting ideas with implementation.</p><div class='story-card-decor' aria-hidden='true'>✳</div></div>
        <div class='story-timeline'>
          {education.map((item, i) => <a class='timeline-entry' href={item.url} target='_blank' rel='noopener noreferrer'><span class='timeline-dot'></span><div><span class='timeline-date'>{item.period}</span><h3>{item.school}</h3><p>{item.degree}</p></div><span class='timeline-arrow' aria-hidden='true'>↗</span></a>)}
        </div>
      </div>
    </section>

    <section class='home-section writing-section reveal' aria-labelledby='writing-title'>
      <div class='section-heading'><div><span class='section-index'><span class='section-index-line'></span> 03 / NOTES & IDEAS</span><h2 id='writing-title'>From my <em>notebook.</em></h2><p>Lessons, thoughts, and things worth documenting along the way.</p></div><a class='text-link' href='/blog'>Read the blog <span aria-hidden='true'>↗</span></a></div>
      <div class='writing-list'>{latestPosts.map((post, index) => <a class='writing-item' href={`/blog/${post.id}`}><span class='writing-number'>{String(index + 1).padStart(2, '0')}</span><span class='writing-copy'><strong>{post.data.title}</strong><span>{post.data.description}</span></span><span class='writing-date'>{dateLabel(post.data.publishDate)}</span><span class='writing-arrow' aria-hidden='true'>↗</span></a>)}</div>
    </section>

    <section class='home-section skills-section reveal' aria-labelledby='skills-title'>
      <div class='section-heading'><div><span class='section-index'><span class='section-index-line'></span> 04 / MY TOOLBOX</span><h2 id='skills-title'>Tools of the <em>trade.</em></h2><p>Technologies I've worked with and continue to learn.</p></div></div>
      <div class='skills-panel'>{skillGroups.map((group, index) => <div class='skill-row'><span class='skill-row-index'>0{index + 1}</span><h3>{group.title}</h3><div class='skill-chips'>{group.items.map((name) => <span class='skill-chip'>{name}</span>)}</div></div>)}</div>
      <div class='research-note'><span class='research-symbol'>✳</span><div><strong>Research & publications</strong><p>{publications[0].venue} {publications[0].year} and earlier conference work.</p></div><a href={publications[0].href} target='_blank' rel='noopener noreferrer' aria-label='View publication'>↗</a></div>
    </section>

    <section id='contact' class='contact-section reveal' aria-labelledby='contact-title'>
      <div class='contact-glow' aria-hidden='true'></div>
      <span class='section-index'>05 / SAY HELLO</span>
      <h2 id='contact-title'>Let's make something <em>meaningful.</em></h2>
      <p>Have an idea, a question, or an opportunity to collaborate? I'd love to hear from you.</p>
      <a class='btn-primary contact-email-cta' href={`mailto:${contact.email}`}>Send me an email <span aria-hidden='true'>↗</span></a>
      <ContactMethods />
      <span class='contact-decoration' aria-hidden='true'>✳</span>
    </section>
  </main>
</PageLayout>
